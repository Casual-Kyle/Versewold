{
  "name": "versewold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/compile-form-schema.mjs",
    "dev": "vite",
    "prebuild": "node scripts/compile-form-schema.mjs && node scripts/collect-editor-licenses.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit",
    "catalog:build": "node ../research/scripts/build-form-catalog.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/compile-form-schema.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ajv": "^8.20.0",
    "syllable": "5.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
